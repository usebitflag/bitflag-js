{
  "name": "@bitflag/js",
  "version": "0.0.0",
  "private": true,
  "description": "BitFlag evaluation core and JavaScript SDK",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "fetch-protocol": "scripts/fetch-protocol-fixtures.sh",
    "conformance": "CONFORMANCE_REPORT=${CONFORMANCE_REPORT:-conformance-report.json} vitest run tests/conformance",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
