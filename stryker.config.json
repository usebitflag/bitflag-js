{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --config vitest.config.ts"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/evaluation/**/*.ts",
    "src/protocol/**/*.ts",
    "!src/evaluation/sha256.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "build/stryker/index.html"
  },
  "tempDirName": "build/stryker-tmp",
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  },
  "timeoutMS": 60000
}
